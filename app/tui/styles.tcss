/* Autogenesia TUI — светлая сине-белая тема (Textual TCSS) */

Screen {
    background: $surface;
    color: $text;
}

ModalScreen {
    align: center middle;
    background: $surface;
}

#dialog-box {
    width: 70%;
    max-width: 100;
    height: auto;
    max-height: 85%;
    border: thick $border;
    background: $surface;
    padding: 1 2;
}

#dialog-label {
    margin-bottom: 1;
}

#dialog-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

Button {
    margin: 0 1;
}

Button.primary {
    background: $accent;
    color: $text;
}

/* Splash safety net (never transparent) */
SplashScreen {
    background: $surface;
    align: center middle;
}

#banner-art {
    color: $accent;
}

#banner-title {
    margin-top: 1;
    color: $text-muted;
}

/* Toolbar */
#toolbar {
    height: auto;
    min-height: 3;
    align-vertical: middle;
}

#toolbar Button {
    min-width: 12;
    height: 3;
    margin: 0 1;
    content-align: center middle;
}

#app-status {
    width: 1fr;
    height: auto;
    padding: 0 1;
    content-align: left middle;
}

/* Stop button styling */
#stop-btn {
    background: $stop;
    color: $text;
}

/* Action bar */
#action-bar {
    height: auto;
    max-height: 6;
    width: 100%;
    overflow-x: auto;
    margin: 0;
    padding: 0;
}

#action-bar Button {
    min-width: 14;
    height: 3;
    margin: 0 1;
    content-align: center middle;
}

#action-panel {
    height: auto;
    margin: 1 0;
}

#tabs {
    height: 1fr;
}

TabPane {
    background: $surface;
}

#chat {
    height: 1fr;
    border: round $border;
    padding: 0 1;
}

.diff-table {
    height: auto;
    max-height: 12;
}

#status-label {
    color: $text;
    padding: 0 1;
}

#session-status {
    color: $text-muted;
    padding: 0 1;
}

#query-input {
    height: 3;
    margin: 1 0;
}

/* Menu boxes (19+ options; scrollable) */
#menu-box {
    width: 78%;
    max-width: 110;
    height: auto;
    max-height: 90%;
    border: thick $border;
    background: $surface;
    padding: 1 2;
    overflow-y: auto;
}

#menu-title {
    margin-bottom: 1;
}

#provider-status, #env-status, #mcp-status {
    margin-bottom: 1;
}

OptionList {
    height: auto;
    max-height: 24;
    overflow-y: auto;
}