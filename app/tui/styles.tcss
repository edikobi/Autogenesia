/* Autogenesia TUI — светлая сине-белая тема (Textual TCSS) */

Screen {
    background: $surface;
    color: $text;
}

Header {
    background: $primary;
    color: #FFFFFF;
    text-style: bold;
}

Footer {
    background: $surface;
    color: $text;
    border-top: solid $border;
}

/* ── Модальные экраны и диалоги ─────────────────────────────────────────── */

ModalScreen {
    align: center middle;
    background: $surface;
}

#dialog-box {
    width: 70%;
    max-width: 92;
    height: auto;
    max-height: 85%;
    border: thick $border;
    background: $surface;
    padding: 1 2;
}

#dialog-label {
    margin-bottom: 1;
}

#dialog-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

Button {
    margin: 0 1;
    min-width: 12;
    height: 3;
    color: $text;
    content-align: center middle;
}

Button.primary,
Button.-primary {
    background: $accent;
    color: #FFFFFF;
    text-style: bold;
}


Button:hover {
    background: $accent 20%;
    color: $text;
}

Button:focus {
    background: $accent 30%;
    color: $text;
    text-style: bold;
}

Button.-primary:hover {
    background: $accent 85%;
    color: #FFFFFF;
}

Button.-primary:focus {
    background: $accent;
    color: #FFFFFF;
    text-style: bold;
}


/* Диалоговые кнопки: читаемый $text на светлой $surface; primary — белый на тёмном $accent */
#dialog-buttons Button {
    margin-left: 1;
    min-width: 14;
}

#dialog-buttons Button.primary,
#dialog-buttons Button.-primary {
    background: $accent;
    color: #FFFFFF;
}


/* ── Splash screen (безопасный непрозрачный фон) ────────────────────────── */

SplashScreen {
    background: $surface;
}

#banner-art {
    margin: 1 2;
}

#banner-title {
    margin: 1 2;
    color: $text;
}

/* ── Тулбар ─────────────────────────────────────────────────────────────── */

#toolbar {
    height: auto;
    min-height: 3;
    align-vertical: middle;
}

#toolbar Button {
    min-width: 12;
    height: 3;
    content-align: center middle;
}

#app-status {
    width: 1fr;
    color: $text;
    content-align: left middle;
}

#stop-btn {
    background: $error;
    color: #FFFFFF;
}

#stop-btn:hover,
#stop-btn:focus {
    background: #8B0000;
    color: #FFFFFF;
}

/* ── Панель действий и бар кнопок ───────────────────────────────────────── */

#action-bar {
    height: auto;
    max-height: 6;
    overflow-x: auto;
    align-vertical: middle;
}

#action-bar Button {
    min-width: 12;
    height: 3;
    content-align: center middle;
}

#action-panel {
    height: auto;
    border-top: solid $border;
}

#action-panel Button {
    min-width: 12;
    height: 3;
    content-align: center middle;
}

#accept-btn {
    background: $success;
    color: #FFFFFF;
}

#rework-btn {
    background: $warning;
    color: $text;
}


#cancel-btn {
    background: $error;
    color: #FFFFFF;
}

#tester-btn {
    background: $primary;
    color: $text;
}


#diff-btn {
    background: $accent;
    color: #FFFFFF;
}

/* ── Вкладки и воркспейс ────────────────────────────────────────────────── */

#tabs {
    height: 1fr;
}

TabPane {
    padding: 0 1;
}

#chat {
    height: 1fr;
    border: round $border;
}

.diff-table {
    border: solid $diff-border;
}

DataTable.diff-table {
    border: solid $diff-border;
    background: $surface;
    color: $text;
}

#status-label {
    color: $text;
}

#session-status {
    color: $text-muted;
}

#query-input {
    dock: bottom;
}

/* ── Меню ───────────────────────────────────────────────────────────────── */

#menu-box {
    width: 60;
    height: 100%;
    max-height: 100%;
    layout: vertical;
    overflow-y: hidden;
    border: thick $border;
    background: $surface;
    padding: 0 2;
}

#menu-box OptionList {
    height: 1fr;
    min-height: 3;
    max-height: 1fr;
    overflow-y: auto;
}

#menu-box > #dialog-buttons {
    dock: bottom;
    height: 3;
    min-height: 3;
    margin-top: 0;
}


#menu-title {
    margin-bottom: 0;
    text-style: bold;
}


#provider-status, #env-status, #mcp-status {
    margin-bottom: 1;
    color: $text;
}

OptionList {
    overflow-y: auto;
}

/* ── Просмотр диффов ────────────────────────────────────────────────────── */

#diff-viewer {
    width: 96%;
    max-width: 170;
    height: 90%;
    border: thick $diff-border;
    background: $surface;
    padding: 0 1;
}

#diff-header {
    height: auto;
}

#diff-title {
    width: 1fr;
    padding: 0 1;
    color: $text;
}